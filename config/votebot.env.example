# ---------------------------------------------------------------------------
# WARDOGS map vote bot - settings. Copy to /etc/wardogs-votebot/votebot.env
# (owner root, mode 640, group votebot). Secrets do NOT go in this file:
# put them in systemd credentials (see README) or *_FILE paths.
# ---------------------------------------------------------------------------

# Your Discord server ID (right-click server icon -> Copy Server ID; needs Developer Mode)
DISCORD_GUILD_ID=000000000000000000

# Optional: only answer in these channel IDs (comma separated). Empty = any channel.
VOTE_CHANNEL_IDS=
# Optional: roles allowed to use /voteadmin (comma separated). Empty = Manage Server permission.
ADMIN_ROLE_IDS=

# WARDOGS RCON endpoint from your game host's panel. Prefer https://.
RCON_BASE_URL=https://203.0.113.10:27016
# Only if your host offers plain http and you've IP-allow-listed this machine:
RCON_ALLOW_INSECURE_HTTP=false
# Optional: pin a self-signed RCON certificate / private CA
RCON_CA_FILE=

# Secrets (used only if systemd credentials are not configured)
# DISCORD_TOKEN_FILE=/etc/wardogs-votebot/discord_token
# RCON_PASSWORD_FILE=/etc/wardogs-votebot/rcon_password

# --- Voting rules ---
# must be on the server this long (continuously) before voting
MIN_PRESENCE_MINUTES=10
# short disconnects / map loads don't reset the timer
PRESENCE_GRACE_SECONDS=180
MAX_VOTES_PER_MAP=3
# /voteup: extra votes that back a pick someone already made (0 = /voteup off)
UPVOTES_PER_MAP=0
# most upvotes one player may give the same pick (0 = no extra cap)
UPVOTE_MAX_PER_OPTION=0
# true = the map that is playing now can't be voted for the next round
BLOCK_CURRENT_MAP=false
# additive = every vote counts | latest = only a player's newest vote counts
VOTE_COUNTING=additive
# --- Applying the winner (rotation-slot override; the bot NEVER force-changes the map) ---
# rotation_slot = when voting closes, the winner replaces the NEXT entry of your ordered rotation;
#                 the default entry is put back after the voted round starts.
# off           = votes only; staff apply the winner by hand.
MAP_APPLICATION_MODE=rotation_slot
# admin = staff run /voteadmin finalize near the end of the match (nothing automatic)
# timer = voting closes automatically VOTE_CLOSE_AFTER_MINUTES after the match started
# live  = no manual step: as soon as the leader has MIN_VOTES_TO_FINALIZE votes the bot puts it in
#         the next rotation slot, and swaps it if another map takes the lead. Voting stays open
#         until the match ends. /voteadmin finalize still works (locks in the current leader).
VOTE_CLOSE_MODE=live
VOTE_CLOSE_AFTER_MINUTES=30
# live mode limits (protect the RCON budget): wait this long after a new leader appears,
LIVE_APPLY_SETTLE_SECONDS=20
# at least this long between rotation writes,
LIVE_APPLY_MIN_INTERVAL_SECONDS=60
# and at most this many automatic writes per match
LIVE_APPLY_MAX_WRITES=8
# the leader needs at least this many votes, otherwise the rotation is not touched
MIN_VOTES_TO_FINALIZE=3
# wait this long after the voted round loads before putting the default entry back
RESTORE_DELAY_SECONDS=45
# Discord channel for "Vote closed; next round: ..." (optional)
ANNOUNCE_CHANNEL_ID=
# private staff channel for safety alerts (conflicts, failed restores) - strongly recommended
ADMIN_ALERT_CHANNEL_ID=
# in-game chat announcements: off | match_end | changes
BROADCAST_MODE=off
# detect a new match even when the same map is replayed
DETECT_SCORE_RESET=true

# --- Behaviour ---
RCON_POLL_SECONDS=15
# true = only the voter sees replies; false = replies are public
EPHEMERAL_REPLIES=true
RESULTS_MAX_LINES=10
LINK_CODE_TTL_SECONDS=300
# name shown at the start of in-game whispers (link codes)
SERVER_DISPLAY_NAME=Map vote bot
# true = finalize only runs the server's validate (dry run); nothing is written
DRY_RUN=false

# --- Paths ---
DATA_DIR=/var/lib/wardogs-votebot
MESSAGES_FILE=/etc/wardogs-votebot/messages.txt
OPTIONS_FILE=/etc/wardogs-votebot/options.json
LOG_LEVEL=INFO

# --- More than one game server (optional) ---
# For several servers run: sudo bash deploy/manage_servers.sh
# It adds the SERVERS_FILE line below for you. Everything above becomes the shared default;
# each server can override most of it.
# SERVERS_FILE=/etc/wardogs-votebot/servers.json
# Internal id of the single server (used to key stored data). Leave as is.
# SERVER_ID=main
